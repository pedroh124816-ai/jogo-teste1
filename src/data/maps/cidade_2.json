            },
            {
              "name": "text",
              "type": "string",
              "value": "Há correntes de ferro no\nfundo do caixote... e uma\ncriança Veyra escondida!\n---\nVocê solta os grilhões em\nsegredo. Garo trafica\ncativos para a Coroa!"
            }
          ]
        },
        {
          "id": 3,
          "name": "Garo",
          "type": "npc",
          "x": 80,
          "y": 160,
          "width": 16,
          "height": 16,
          "properties": [
            {
              "name": "sprite",
