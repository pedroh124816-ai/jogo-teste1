            },
            {
              "name": "setFlagOnTalk",
              "type": "string",
              "value": "tavo_investigando"
            },
            {
              "name": "dialogue",
              "type": "string",
              "value": "Bom ver você, [NOME]!\nInvestiguei os caixotes\nde Garo no cais ao sul...\n---\nEles levam gente presa!\nE o rebelde Brasca está\nna Gruta da Costa a leste!"
            }
          ]
        },
        {
          "id": 5,
