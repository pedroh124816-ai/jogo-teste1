            },
            {
              "name": "dialogue",
              "type": "string",
              "value": "Vael me mandou vigiar o\nporto, [NOME]... Meu irmão\nPim depende de mim."
            },
            {
              "name": "altDialogue",
              "type": "string",
              "value": "Perdoe-me, [NOME]! Vael\ntinha Pim como refém na\nCripta do Santuário!"
            }
          ]
        },
