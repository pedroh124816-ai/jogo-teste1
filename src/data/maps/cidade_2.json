            },
            {
              "name": "direction",
              "type": "string",
              "value": "down"
            },
            {
              "name": "altFlag",
              "type": "string",
              "value": "garo_carga_vista"
            },
            {
              "name": "dialogue",
              "type": "string",
              "value": "Bem-vindo ao Porto do Sol!\nMeus navios levam suprimento\npara as minas da Coroa."
            },
            {
              "name": "altDialogue",
              "type": "string",
              "value": "Cargas especiais? Mão de\nobra contratada, herói.\nTudo dentro da lei.\n---\nAs correntes? Costume\ndo ofício. Só isso."
            }
          ]
        },
        {
          "id": 4,
          "name": "Mestre Tavo",
          "type": "npc",
          "x": 160,
          "y": 80,
